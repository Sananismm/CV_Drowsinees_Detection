{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SG-4 to SG-5 Temporal Cues V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "session_id", "driver_track_id", "timestamp_ms", "window_ms", "temporal_confidence", "eye", "yawn", "fatigue"],
  "properties": {
    "schema_version": {"const": "sg5.temporal-cues.v1"},
    "session_id": {"type": "string", "minLength": 1},
    "driver_track_id": {"type": "string", "minLength": 1},
    "timestamp_ms": {"type": "integer", "minimum": 0, "description": "Monotonic milliseconds from session start."},
    "window_ms": {"type": "integer", "minimum": 1000, "description": "Duration of the temporal aggregation window."},
    "temporal_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "eye": {
      "type": "object", "additionalProperties": false,
      "required": ["perclos", "longest_closure_ms", "blink_rate_per_min", "confidence"],
      "properties": {
        "perclos": {"type": "number", "minimum": 0, "maximum": 1},
        "longest_closure_ms": {"type": "integer", "minimum": 0},
        "blink_rate_per_min": {"type": "number", "minimum": 0},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "yawn": {
      "type": "object", "additionalProperties": false,
      "required": ["count", "total_duration_ms", "confidence"],
      "properties": {
        "count": {"type": "integer", "minimum": 0, "description": "Yawns observed in window_ms."},
        "total_duration_ms": {"type": "integer", "minimum": 0},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "fatigue": {
      "type": "object", "additionalProperties": false,
      "required": ["persistence", "confidence"],
      "properties": {
        "persistence": {"type": "number", "minimum": 0, "maximum": 1, "description": "Fraction of recent window containing fatigue evidence."},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
