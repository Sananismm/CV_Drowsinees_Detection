{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SG-1: Live webcam",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/live_demo.py",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "args": ["--camera", "0"]
    },
    {
      "name": "SG-1: Downloaded video fallback",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/live_demo.py",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "args": ["--video", "${env:USERPROFILE}/Downloads/P10427801_na.mp4"]
    }
  ]
}
